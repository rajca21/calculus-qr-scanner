{
  "expo": {
    "name": "Calculus Čitač Fiskala",
    "slug": "calculus-citac-fiskala",
    "owner": "nikolacalculusmd",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calculusqr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "description": "Aplikacija za očitanje fiskalnih računa povezana sa Calculus bazom podataka.",
    "primaryColor": "#699cf5",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.calculus.calculuscitacfiskala",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 4,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "package": "com.calculus.calculuscitacfiskala",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#699cf5",
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow camera access to scan fiscal receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dozvolite Calculus aplikaciji da pristupi Vašoj galeriji radi skeniranja QR koda sa slike",
          "cameraPermission": "Dozvolite Calculus aplikaciji da koristi kameru za skeniranje QR koda",
          "microphonePermission": "Dozvolite Calculus aplikaciji da koristi mikrofon"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "locales": {
      "en": "./locales/en.json",
      "sr": "./locales/sr.json",
      "hr": "./locales/hr.json",
      "bs": "./locales/bs.json",
      "sl": "./locales/sl.json",
      "mk": "./locales/mk.json"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0caab71a-4d64-41b0-bef0-4f13c675c7c4"
      }
    }
  }
}
