{
  "cli": {
    "version": ">= 4.1.2",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium",
        "image": "sdk-57"
      },
      "node": "22.20.0",
      "android": {
        "buildType": "app-bundle",
        "image": "sdk-57"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
